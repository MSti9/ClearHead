# Backend environment — copy this file to `.env` and fill in real values.
# Never commit `.env`; it is gitignored.

# Server port. Optional — backend/src/env.ts defaults to 3000.
PORT=3000

# OpenAI — used by /api/ai/transcribe (Whisper, model gpt-4o-mini-transcribe)
# and /api/ai/tts (TTS, model tts-1, voice nova).
OPENAI_API_KEY=

# Anthropic — used by /api/ai/chat and /api/ai/reflect
# (Claude Sonnet 4.5, model id claude-sonnet-4-5-20250929).
ANTHROPIC_API_KEY=
