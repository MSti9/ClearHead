# Mobile environment — copy this file to `.env` and fill in real values.
# Never commit `.env`; it is gitignored.
#
# These EXPO_PUBLIC_* values are inlined into the client bundle at build time.
# RevenueCat publishable keys are designed to ship in the bundle, but they are
# still per-developer / per-environment, so each developer fills them in locally.

# Where the mobile app reaches the backend. Default for local dev:
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000

# RevenueCat — get keys from https://app.revenuecat.com → Project settings → API keys.
# TEST is used in __DEV__ builds. APPLE/GOOGLE are used in production builds on
# their respective platforms (see mobile/src/lib/revenuecatClient.ts).
EXPO_PUBLIC_VIBECODE_REVENUECAT_TEST_KEY=
EXPO_PUBLIC_VIBECODE_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_VIBECODE_REVENUECAT_GOOGLE_KEY=
